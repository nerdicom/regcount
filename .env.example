# Leave disabled until the data provider permits this public use.
REGCOUNT_LIVE_ENABLED=false
DOTDB_API_KEY=

# Social login. Keep all secrets in Hostinger environment variables.
NEXTAUTH_URL=https://regcount.com
# Generate a persistent secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional public ownership-verification tokens (not OAuth secrets). Redeploy after setting.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
